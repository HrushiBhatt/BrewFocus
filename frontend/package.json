{
  "name": "brew-focus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The Brew Focus web app: React, built with Vite.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "e2e": "vite build && playwright test",
    "e2e:pages": "playwright test --config playwright.pages.config.js"
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
