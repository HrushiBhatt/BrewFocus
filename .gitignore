# ---- secrets & local config: never commit these -------------------------------
# Real values live in .env (copy .env.example); keys and certificates stay local.
# CI also scans every commit with gitleaks, in case something gets past these rules.
.env
.env.*
!.env.example
.envrc
.netrc
.npmrc
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der
*.gpg
*.asc
id_rsa*
id_ed25519*
*.secret
*.secrets
secrets/
.secrets/

# Google Cloud downloads its OAuth client and service account keys as JSON files.
client_secret*.json
credentials*.json
service-account*.json
*-service-account.json
token.json
tokens.json

# SQLite databases hold user accounts (emails, password hashes) and sessions, and backups
# or dumps of them hold exactly the same data.
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.dump
*.sql.gz
*.bak
*.backup
backups/

# ---- build output & dependencies ---------------------------------------------
# All of it is rebuilt by `make install`, `make build` or the tests.
node_modules/
frontend/dist/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/
backend/target/
# The wrapper script downloads Maven itself; a wrapper jar is never needed.
**/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
hs_err_pid*.log
replay_pid*.log
.eslintcache
*.tsbuildinfo
__pycache__/
*.pyc

# ---- editor & OS noise -------------------------------------------------------------
.DS_Store
Thumbs.db
*.log
*.swp
*~
.idea/
*.iml
.vscode/
# Eclipse and the VS Code Java extension write project files next to the pom.
.project
.classpath
.settings/
.factorypath
bin/
